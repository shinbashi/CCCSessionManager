{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CCCSessionManager",
  "version": "0.2.3",
  "identifier": "io.github.shinbashi.cccsessionmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CCCSessionManager",
        "width": 1200,
        "height": 760,
        "minWidth": 800,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4QThDQzE2QzA0N0YxMUYKUldRZjhVZkFGc3lvMk80UVVNN2x4MEdBbC90L3lKL050ZHJzcTdDSDZtay9nKzlXYkwrL0dEeGQK",
      "endpoints": [
        "https://github.com/shinbashi/CCCSessionManager/releases/latest/download/latest.json"
      ]
    }
  }
}
